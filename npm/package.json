{
  "name": "inkoxide",
  "version": "0.1.0",
  "description": "Native PDF layout and rendering engine: declarative document tree in, PDF bytes out.",
  "license": "MIT",
  "repository": "github:eddiesr93/inkoxide",
  "main": "index.js",
  "types": "index.d.ts",
  "files": ["index.js", "index.d.ts", "*.node"],
  "engines": { "node": ">= 18" },
  "scripts": {
    "build": "../scripts/build-node.sh",
    "test": "node --test test/*.test.js test/*.test.mjs"
  },
  "napi": {
    "binaryName": "inkoxide",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "optionalDependencies": {}
}
