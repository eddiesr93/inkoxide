/packages/conformance/.angular-aot-*/
/packages/conformance/.angular-cli-*/

# Playwright, in examples/browser and examples/frameworks
/examples/browser/test-results/
/examples/browser/playwright-report/
/examples/frameworks/test-results/
/examples/frameworks/playwright-report/

