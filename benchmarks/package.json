{
  "name": "@inkoxide/benchmarks",
  "private": true,
  "type": "module",
  "description": "Inkoxide compared with @react-pdf/renderer on the same documents.",
  "scripts": {
    "react-pdf": "tsx invoice-react-pdf.tsx",
    "react-pdf-tailwind": "tsx invoice-react-pdf-tailwind.tsx",
    "inkoxide": "tsx invoice-inkoxide.tsx",
    "all": "pnpm react-pdf && pnpm react-pdf-tailwind && pnpm inkoxide",
    "bench": "NODE_ENV=production tsx bench.tsx"
  },
  "dependencies": {
    "@inkoxide/render": "workspace:*",
    "@react-pdf/renderer": "4.9.0",
    "react": "19.3.0",
    "react-pdf-tailwind": "3.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "tsx": "4.23.15"
  }
}
