{
  "name": "@inkoxide/render",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Inkoxide engine with its bundled fonts, for every front end: renderDocument, Font.register, and the renderer a front end (React, Vue, Svelte, Angular) exports.",
  "exports": {
    ".": "./src/index.ts",
    "./templates": "./src/templates.ts",
    "./browser": "./src/browser.ts"
  },
  "dependencies": {
    "@inkoxide/schema": "workspace:*",
    "@inkoxide/tree": "workspace:*",
    "inkoxide": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@inkoxide/tailwind": "workspace:*",
    "@inkoxide/wasm": "workspace:*"
  },
  "peerDependencies": {
    "@inkoxide/tailwind": "workspace:*",
    "@inkoxide/wasm": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@inkoxide/tailwind": {
      "optional": true
    },
    "@inkoxide/wasm": {
      "optional": true
    }
  }
}
