{
  "name": "inkoxide",
  "version": "0.6.2",
  "description": "Native PDF layout and rendering engine: declarative document tree in, PDF bytes out.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddiesr93/inkoxide.git",
    "directory": "packages/inkoxide"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "../../scripts/build-node.sh",
    "test": "node --test test/*.test.js"
  },
  "napi": {
    "binaryName": "inkoxide",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "optionalDependencies": {},
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
