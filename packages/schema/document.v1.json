{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkoxide.dev/schema/document.v1.json",
  "title": "Inkoxide document, version 1",
  "description": "A fully resolved, declarative document tree rendered to PDF by the Inkoxide engine. All lengths are PDF points (1/72 in); all colours are RGBA floats in [0, 1]. Unknown properties are errors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "pages"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "fonts": {
      "description": "Fonts the document references. Bytes are registered through the API (registerFont / options); this list lets validation fail early.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/FontDecl"
      }
    },
    "fallbackFonts": {
      "description": "Font ids tried, in order, for characters missing from a run's font. Every id must be declared in `fonts`.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/PageSpec"
      }
    }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "Link": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "Link target. `#id` jumps to the top of the first node with that `id` (`UNKNOWN_ANCHOR` if none); anything else must be an absolute URI with a scheme (`https:`, `mailto:`, …) and opens in the viewer. `javascript:` is rejected."
    },
    "Bookmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "description": "Document outline entry pointing at the top of its node. Entries appear in document order; an entry nests under the nearest earlier entry with a lower `level`. Flowing content only (not headers or footers).",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 1
        }
      }
    },
    "Debug": {
      "type": "boolean",
      "default": false,
      "description": "A development aid: draws the element's boxes on top of the page, its margin (orange), border (yellow) and padding (green) as light fills and its content box as a blue outline, with its border-box size in points as a small label. The label is drawn with lines, so no text is added to the document. A box split across pages is drawn on each page it crosses. It changes the output: leave it off in production."
    },
    "Meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "keywords": {
          "type": "string"
        },
        "creator": {
          "type": "string"
        },
        "lang": {
          "type": "string",
          "description": "BCP-47 language tag of the document, e.g. \"en\" or \"en-GB\"."
        },
        "creationDate": {
          "type": "string",
          "format": "date-time",
          "description": "RFC 3339 timestamp written to the PDF Info dictionary. Overridden by the creationDate render option. When neither is set, no date is written (output stays deterministic)."
        }
      }
    },
    "FontDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 400
        },
        "style": {
          "enum": [
            "normal",
            "italic"
          ],
          "default": "normal"
        }
      }
    },
    "NonNegative": {
      "type": "number",
      "minimum": 0
    },
    "Percent": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?%$"
    },
    "Length": {
      "description": "Points, a percentage of the containing block, or \"auto\".",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/Percent"
        },
        {
          "const": "auto"
        }
      ]
    },
    "LengthPercent": {
      "description": "Points or a percentage of the containing block's width.",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/Percent"
        }
      ]
    },
    "Color": {
      "description": "[r, g, b, a], each in [0, 1].",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "Size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 14400
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 14400
        }
      }
    },
    "EdgesNumber": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": {
          "$ref": "#/$defs/NonNegative"
        },
        "right": {
          "$ref": "#/$defs/NonNegative"
        },
        "bottom": {
          "$ref": "#/$defs/NonNegative"
        },
        "left": {
          "$ref": "#/$defs/NonNegative"
        }
      }
    },
    "EdgesLengthPercent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": {
          "$ref": "#/$defs/LengthPercent"
        },
        "right": {
          "$ref": "#/$defs/LengthPercent"
        },
        "bottom": {
          "$ref": "#/$defs/LengthPercent"
        },
        "left": {
          "$ref": "#/$defs/LengthPercent"
        }
      }
    },
    "EdgesLength": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": {
          "$ref": "#/$defs/Length"
        },
        "right": {
          "$ref": "#/$defs/Length"
        },
        "bottom": {
          "$ref": "#/$defs/Length"
        },
        "left": {
          "$ref": "#/$defs/Length"
        }
      }
    },
    "EdgesColor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": {
          "$ref": "#/$defs/Color"
        },
        "right": {
          "$ref": "#/$defs/Color"
        },
        "bottom": {
          "$ref": "#/$defs/Color"
        },
        "left": {
          "$ref": "#/$defs/Color"
        }
      }
    },
    "PageSpec": {
      "description": "A page template. Its content flows across as many physical pages as needed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size"
      ],
      "properties": {
        "size": {
          "$ref": "#/$defs/Size"
        },
        "margin": {
          "$ref": "#/$defs/EdgesNumber"
        },
        "background": {
          "$ref": "#/$defs/Color"
        },
        "debug": {
          "$ref": "#/$defs/Debug",
          "description": "Draws the boxes of the page (its margins and content area) and of every element on it, the header and footer included."
        },
        "header": {
          "description": "Laid out once at the full page width and painted at the top of every physical page (y = 0). Use padding to inset it. Size the top margin to leave room for it.",
          "$ref": "#/$defs/Node"
        },
        "footer": {
          "description": "Laid out once at the full page width and painted with its bottom edge on the bottom of every physical page.",
          "$ref": "#/$defs/Node"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          }
        }
      }
    },
    "Break": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before": {
          "enum": [
            "auto",
            "page"
          ],
          "default": "auto"
        },
        "after": {
          "enum": [
            "auto",
            "page"
          ],
          "default": "auto"
        },
        "inside": {
          "enum": [
            "auto",
            "avoid"
          ],
          "default": "auto"
        },
        "minPresenceAhead": {
          "$ref": "#/$defs/NonNegative"
        },
        "fixed": {
          "description": "Paint the node on every page of its flow. A child of the page with `position: \"absolute\"` is laid out on its own, against the page content box (`inset` and percentages are relative to one page's content box, inside the margins), takes no space and is painted over the flow. Any other fixed node is laid out in the flow, takes its space there once, and is painted at the same place on every page.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "GridPlacement": {
      "description": "1-based CSS grid line placement. Negative lines count from the end. Use `span` alone or with `start`.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        },
        "span": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "TrackSize": {
      "description": "Grid track: a breadth, `{min, max}` (CSS `minmax()`; `min` cannot be fr) or `{fitContent}` (CSS `fit-content()`).",
      "oneOf": [
        {
          "$ref": "#/$defs/TrackBreadth"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "$ref": "#/$defs/TrackBreadth"
            },
            "max": {
              "$ref": "#/$defs/TrackBreadth"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fitContent"
          ],
          "properties": {
            "fitContent": {
              "$ref": "#/$defs/LengthPercent"
            }
          }
        }
      ]
    },
    "BorderRadius": {
      "description": "One radius for every corner, or one per corner (a missing corner is square). Radii that would overlap are scaled down together, as in CSS.",
      "oneOf": [
        {
          "$ref": "#/$defs/NonNegative"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "topLeft": {
              "$ref": "#/$defs/NonNegative"
            },
            "topRight": {
              "$ref": "#/$defs/NonNegative"
            },
            "bottomRight": {
              "$ref": "#/$defs/NonNegative"
            },
            "bottomLeft": {
              "$ref": "#/$defs/NonNegative"
            }
          }
        }
      ]
    },
    "BorderStyles": {
      "description": "One style for every side, or one per side (an unset side is solid).",
      "oneOf": [
        {
          "enum": [
            "solid",
            "dashed",
            "dotted"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": {
              "enum": [
                "solid",
                "dashed",
                "dotted"
              ]
            },
            "right": {
              "enum": [
                "solid",
                "dashed",
                "dotted"
              ]
            },
            "bottom": {
              "enum": [
                "solid",
                "dashed",
                "dotted"
              ]
            },
            "left": {
              "enum": [
                "solid",
                "dashed",
                "dotted"
              ]
            }
          }
        }
      ]
    },
    "TransformOp": {
      "description": "One transform function, as an object with exactly one key. Lengths are points or percentages of the node's own border box; angles are degrees, clockwise.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "translate"
          ],
          "properties": {
            "translate": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/LengthPercent"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scale"
          ],
          "properties": {
            "scale": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rotate"
          ],
          "properties": {
            "rotate": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skew"
          ],
          "properties": {
            "skew": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": -90,
                "exclusiveMaximum": 90
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "matrix"
          ],
          "properties": {
            "matrix": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 6,
              "maxItems": 6
            }
          }
        }
      ]
    },
    "Style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display": {
          "enum": [
            "flex",
            "grid",
            "none"
          ],
          "default": "flex"
        },
        "flexDirection": {
          "enum": [
            "row",
            "column",
            "row-reverse",
            "column-reverse"
          ],
          "default": "column"
        },
        "flexWrap": {
          "enum": [
            "nowrap",
            "wrap",
            "wrap-reverse"
          ],
          "default": "nowrap"
        },
        "justifyContent": {
          "enum": [
            "flex-start",
            "flex-end",
            "center",
            "space-between",
            "space-around",
            "space-evenly",
            "start",
            "end",
            "stretch"
          ]
        },
        "alignItems": {
          "enum": [
            "flex-start",
            "flex-end",
            "center",
            "baseline",
            "stretch",
            "start",
            "end"
          ]
        },
        "alignSelf": {
          "enum": [
            "auto",
            "flex-start",
            "flex-end",
            "center",
            "baseline",
            "stretch",
            "start",
            "end"
          ]
        },
        "alignContent": {
          "enum": [
            "flex-start",
            "flex-end",
            "center",
            "space-between",
            "space-around",
            "space-evenly",
            "stretch",
            "start",
            "end"
          ]
        },
        "flexGrow": {
          "$ref": "#/$defs/NonNegative"
        },
        "flexShrink": {
          "$ref": "#/$defs/NonNegative"
        },
        "flexBasis": {
          "$ref": "#/$defs/Length"
        },
        "gap": {
          "$ref": "#/$defs/LengthPercent",
          "description": "Sets both rowGap and columnGap; either of those, when present, wins."
        },
        "rowGap": {
          "$ref": "#/$defs/LengthPercent"
        },
        "columnGap": {
          "$ref": "#/$defs/LengthPercent"
        },
        "width": {
          "$ref": "#/$defs/Length"
        },
        "height": {
          "$ref": "#/$defs/Length"
        },
        "minWidth": {
          "$ref": "#/$defs/Length"
        },
        "minHeight": {
          "$ref": "#/$defs/Length"
        },
        "maxWidth": {
          "$ref": "#/$defs/Length"
        },
        "maxHeight": {
          "$ref": "#/$defs/Length"
        },
        "aspectRatio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "padding": {
          "$ref": "#/$defs/EdgesLengthPercent"
        },
        "margin": {
          "$ref": "#/$defs/EdgesLength"
        },
        "position": {
          "enum": [
            "relative",
            "absolute"
          ],
          "default": "relative"
        },
        "inset": {
          "$ref": "#/$defs/EdgesLength",
          "description": "top/right/bottom/left offsets for positioned boxes."
        },
        "gridTemplateColumns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TemplateTrack"
          }
        },
        "gridTemplateRows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TemplateTrack"
          }
        },
        "gridTemplateAreas": {
          "description": "Rows of whitespace-separated area names, as in CSS; a token of dots is an unnamed cell. Every row has the same number of cells and each area is a rectangle.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "gridAutoColumns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TrackSize"
          }
        },
        "gridAutoRows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TrackSize"
          }
        },
        "gridAutoFlow": {
          "enum": [
            "row",
            "column",
            "row dense",
            "column dense"
          ]
        },
        "gridColumn": {
          "$ref": "#/$defs/GridPlacement"
        },
        "gridRow": {
          "$ref": "#/$defs/GridPlacement"
        },
        "gridArea": {
          "description": "Name of an area in the parent's `gridTemplateAreas`; replaces `gridRow` and `gridColumn`.",
          "type": "string",
          "minLength": 1
        },
        "justifyItems": {
          "enum": [
            "flex-start",
            "flex-end",
            "center",
            "baseline",
            "stretch",
            "start",
            "end"
          ],
          "description": "Grid only: default inline-axis alignment of the items."
        },
        "justifySelf": {
          "enum": [
            "auto",
            "flex-start",
            "flex-end",
            "center",
            "baseline",
            "stretch",
            "start",
            "end"
          ],
          "description": "Grid only: inline-axis alignment of this item."
        },
        "overflow": {
          "enum": [
            "visible",
            "hidden"
          ],
          "default": "visible"
        },
        "backgroundColor": {
          "$ref": "#/$defs/Color"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "borderWidth": {
          "$ref": "#/$defs/EdgesNumber"
        },
        "borderColor": {
          "$ref": "#/$defs/EdgesColor"
        },
        "borderRadius": {
          "$ref": "#/$defs/BorderRadius"
        },
        "borderStyle": {
          "$ref": "#/$defs/BorderStyles",
          "description": "default `\"solid\"`"
        },
        "rotate": {
          "type": "number",
          "description": "Degrees, clockwise, around the box centre."
        },
        "transform": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TransformOp"
          },
          "description": "Transform functions, as in CSS: the list applies right to left, after `rotate`. Not on table cells. A transformed node moves to the next page as a whole."
        },
        "transformOrigin": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LengthPercent"
          },
          "minItems": 2,
          "description": "x and y of the origin of `rotate` and `transform` within the border box. Default `[\"50%\", \"50%\"]`.",
          "maxItems": 2
        },
        "zIndex": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "description": "Paint order among siblings: higher paints later (above); equal values keep document order. Default 0. Not on table cells."
        },
        "textAlign": {
          "enum": [
            "left",
            "center",
            "right",
            "justify",
            "start",
            "end"
          ],
          "description": "text nodes only; `start`/`end` follow the paragraph direction. Default `start`."
        },
        "lineHeight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "text nodes only; multiplier of the largest run size on the line"
        },
        "maxLines": {
          "type": "integer",
          "minimum": 1,
          "description": "text nodes only"
        },
        "ellipsis": {
          "type": "boolean",
          "description": "text nodes only; requires maxLines"
        },
        "hyphenate": {
          "type": "boolean",
          "description": "text nodes only"
        },
        "lang": {
          "type": "string",
          "description": "text nodes only; BCP-47, selects hyphenation patterns"
        },
        "whiteSpace": {
          "enum": [
            "normal",
            "pre",
            "nowrap",
            "pre-wrap",
            "pre-line"
          ],
          "description": "text nodes only. `normal` collapses spaces and keeps newlines as breaks (as `pre-line`); `pre-wrap` keeps spaces and tabs and wraps."
        },
        "textIndent": {
          "type": "number",
          "description": "text nodes only; indent of the first line in points (negative: hanging indent)"
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl",
            "auto"
          ],
          "default": "ltr",
          "description": "text nodes only; base direction of the paragraph (`auto`: from its first strong character). Right-to-left runs are reordered with the Unicode bidi algorithm in any direction."
        },
        "orphans": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 1,
          "description": "text nodes only; minimum number of lines left at the bottom of a page when the paragraph breaks"
        },
        "widows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 1,
          "description": "text nodes only; minimum number of lines carried to the top of the next page when the paragraph breaks"
        },
        "verticalAlign": {
          "enum": [
            "top",
            "middle",
            "bottom"
          ],
          "description": "table cells only"
        },
        "borderCollapse": {
          "enum": [
            "collapse",
            "separate"
          ],
          "default": "collapse",
          "description": "Tables only. `collapse`: adjacent cell borders merge (the wider wins). `separate`: every cell draws its own borders, background and `borderRadius`, `borderSpacing` apart."
        },
        "borderSpacing": {
          "$ref": "#/$defs/NonNegative",
          "description": "Tables with `borderCollapse: separate` only: space between cells and around them, in points. Default 0."
        }
      }
    },
    "TextRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "font",
        "size"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "Required unless `placeholder` is set; forbidden when it is."
        },
        "font": {
          "$ref": "#/$defs/Id"
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "color": {
          "$ref": "#/$defs/Color"
        },
        "letterSpacing": {
          "type": "number"
        },
        "decoration": {
          "enum": [
            "none",
            "underline",
            "lineThrough"
          ]
        },
        "decorationColor": {
          "$ref": "#/$defs/Color",
          "description": "Default: the run colour."
        },
        "decorationThickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "description": "Points. Default: from the font."
        },
        "decorationStyle": {
          "enum": [
            "solid",
            "double",
            "dotted",
            "dashed",
            "wavy"
          ],
          "default": "solid"
        },
        "placeholder": {
          "enum": [
            "pageNumber",
            "totalPages"
          ]
        },
        "link": {
          "$ref": "#/$defs/Link",
          "description": "Makes the run a link; the clickable area covers the run's glyphs on each line."
        },
        "hyphenate": {
          "type": "boolean",
          "description": "Overrides the text node's `hyphenate` for this run's words, in the node's language."
        }
      },
      "oneOf": [
        {
          "required": [
            "text"
          ],
          "not": {
            "required": [
              "placeholder"
            ]
          }
        },
        {
          "required": [
            "placeholder"
          ],
          "not": {
            "required": [
              "text"
            ]
          }
        }
      ]
    },
    "ColumnSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width"
      ],
      "properties": {
        "width": {
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?fr$"
            },
            {
              "const": "auto"
            }
          ]
        }
      }
    },
    "TableCell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "debug": {
          "$ref": "#/$defs/Debug"
        },
        "colSpan": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "rowSpan": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "style": {
          "$ref": "#/$defs/Style"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          }
        }
      }
    },
    "TableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "debug": {
          "$ref": "#/$defs/Debug"
        },
        "minHeight": {
          "$ref": "#/$defs/NonNegative"
        },
        "backgroundColor": {
          "$ref": "#/$defs/Color"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TableCell"
          }
        }
      }
    },
    "Node": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "box",
            "text",
            "image",
            "table",
            "pageBreak",
            "spacer",
            "field"
          ]
        }
      },
      "discriminator": {
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BoxNode"
        },
        {
          "$ref": "#/$defs/TextNode"
        },
        {
          "$ref": "#/$defs/ImageNode"
        },
        {
          "$ref": "#/$defs/TableNode"
        },
        {
          "$ref": "#/$defs/PageBreakNode"
        },
        {
          "$ref": "#/$defs/SpacerNode"
        },
        {
          "$ref": "#/$defs/FieldNode"
        }
      ]
    },
    "BoxNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "box"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "style": {
          "$ref": "#/$defs/Style"
        },
        "break": {
          "$ref": "#/$defs/Break"
        },
        "link": {
          "$ref": "#/$defs/Link"
        },
        "bookmark": {
          "$ref": "#/$defs/Bookmark"
        },
        "pages": {
          "$ref": "#/$defs/PageFilter"
        },
        "debug": {
          "$ref": "#/$defs/Debug"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          }
        }
      }
    },
    "TextNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "runs"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "style": {
          "$ref": "#/$defs/Style"
        },
        "break": {
          "$ref": "#/$defs/Break"
        },
        "link": {
          "$ref": "#/$defs/Link"
        },
        "bookmark": {
          "$ref": "#/$defs/Bookmark"
        },
        "pages": {
          "$ref": "#/$defs/PageFilter"
        },
        "debug": {
          "$ref": "#/$defs/Debug"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextRun"
          }
        }
      }
    },
    "ImageNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "image"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "style": {
          "$ref": "#/$defs/Style"
        },
        "break": {
          "$ref": "#/$defs/Break"
        },
        "link": {
          "$ref": "#/$defs/Link"
        },
        "bookmark": {
          "$ref": "#/$defs/Bookmark"
        },
        "pages": {
          "$ref": "#/$defs/PageFilter"
        },
        "debug": {
          "$ref": "#/$defs/Debug"
        },
        "src": {
          "$ref": "#/$defs/Id",
          "description": "Key into the render option `images`."
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "Inline image bytes (JPEG, PNG, GIF, WebP or SVG; the first frame of an animation), base64-encoded; a `data:<mime>;base64,` URL is also accepted."
        },
        "fit": {
          "enum": [
            "fill",
            "contain",
            "cover",
            "none"
          ],
          "default": "fill"
        },
        "position": {
          "$ref": "#/$defs/ImagePosition",
          "description": "Where the image sits in its box with `fit` `contain`, `cover` or `none` (CSS `object-position`); `fill` ignores it. Default centred."
        }
      },
      "oneOf": [
        {
          "required": [
            "src"
          ],
          "not": {
            "required": [
              "data"
            ]
          }
        },
        {
          "required": [
            "data"
          ],
          "not": {
            "required": [
              "src"
            ]
          }
        }
      ]
    },
    "ImagePosition": {
      "description": "Position of a fitted image in its box, per axis: a keyword, points from the left or top edge, or a percentage (that point of the image goes to that point of the box: `\"0%\"` is the start edge, `\"100%\"` the end edge). What falls outside the box is clipped.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "oneOf": [
            {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/Percent"
            }
          ],
          "default": "center"
        },
        "y": {
          "oneOf": [
            {
              "enum": [
                "top",
                "center",
                "bottom"
              ]
            },
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/Percent"
            }
          ],
          "default": "center"
        }
      }
    },
    "TableNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "columns",
        "rows"
      ],
      "properties": {
        "type": {
          "const": "table"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "style": {
          "$ref": "#/$defs/Style"
        },
        "break": {
          "$ref": "#/$defs/Break"
        },
        "link": {
          "$ref": "#/$defs/Link"
        },
        "bookmark": {
          "$ref": "#/$defs/Bookmark"
        },
        "pages": {
          "$ref": "#/$defs/PageFilter"
        },
        "debug": {
          "$ref": "#/$defs/Debug"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ColumnSpec"
          }
        },
        "headerRows": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TableRow"
          }
        }
      }
    },
    "PageBreakNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "pageBreak"
        },
        "id": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "SpacerNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "spacer"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "style": {
          "$ref": "#/$defs/Style"
        },
        "break": {
          "$ref": "#/$defs/Break"
        },
        "link": {
          "$ref": "#/$defs/Link"
        },
        "bookmark": {
          "$ref": "#/$defs/Bookmark"
        },
        "pages": {
          "$ref": "#/$defs/PageFilter"
        },
        "debug": {
          "$ref": "#/$defs/Debug"
        }
      }
    },
    "FieldNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "field"
      ],
      "description": "An interactive AcroForm field. `style` sizes and decorates its box (background, border, padding); the widget covers the content box. Without a width or height it takes an intrinsic size (text: 150 pt wide, one line, or three when multiline; checkbox and radio: `size` + 2 pt square).",
      "properties": {
        "type": {
          "const": "field"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "style": {
          "$ref": "#/$defs/Style"
        },
        "break": {
          "$ref": "#/$defs/Break"
        },
        "pages": {
          "$ref": "#/$defs/PageFilter"
        },
        "debug": {
          "$ref": "#/$defs/Debug"
        },
        "field": {
          "$ref": "#/$defs/Field"
        }
      }
    },
    "Field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "description": "Fields with the same `name` are one field with several widgets (for example a field in a header, repeated on every page); only radio buttons may share a name with different values.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^.]+$",
          "description": "Field name (no `.`); unique in the document except for the buttons of one radio group."
        },
        "kind": {
          "enum": [
            "text",
            "checkbox",
            "radio",
            "select"
          ]
        },
        "value": {
          "type": "string",
          "description": "text: the initial text; select: the selected option (one of `options`); radio: the value this button exports when selected."
        },
        "checked": {
          "type": "boolean",
          "default": false,
          "description": "checkbox and radio: initially selected"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "select only: the choices"
        },
        "multiline": {
          "type": "boolean",
          "default": false,
          "description": "text only"
        },
        "password": {
          "type": "boolean",
          "default": false,
          "description": "text only; the value is neither shown nor stored"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "description": "text only; maximum number of characters"
        },
        "readOnly": {
          "type": "boolean",
          "default": false
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "font": {
          "$ref": "#/$defs/Id",
          "description": "text and select (required there): a declared font for the value. Its glyphs for the common Latin range are embedded so edits display."
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "default": 10,
          "description": "font size; also the mark size of checkboxes and radio buttons"
        },
        "color": {
          "$ref": "#/$defs/Color",
          "description": "text and mark colour; default black"
        }
      }
    },
    "TrackBreadth": {
      "description": "Grid track breadth: points, a percentage, \"<n>fr\", \"auto\", \"min-content\" or \"max-content\".",
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "$ref": "#/$defs/Percent"
        },
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?fr$"
        },
        {
          "enum": [
            "auto",
            "min-content",
            "max-content"
          ]
        }
      ]
    },
    "TemplateTrack": {
      "description": "Entry of a track template: a track, or CSS `repeat()` as `{repeat, tracks}`. `auto-fill`/`auto-fit` may appear once per list, and then every track in the list needs a fixed (points or percentage) minimum or maximum.",
      "oneOf": [
        {
          "$ref": "#/$defs/TrackSize"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repeat",
            "tracks"
          ],
          "properties": {
            "repeat": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                {
                  "enum": [
                    "auto-fill",
                    "auto-fit"
                  ]
                }
              ]
            },
            "tracks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/TrackSize"
              }
            }
          }
        }
      ]
    },
    "PageFilter": {
      "description": "Pages that show the node, by physical page number (as the `pageNumber` placeholder). The node keeps its place in the layout on every page; it is only painted on the matching ones.",
      "oneOf": [
        {
          "enum": [
            "first",
            "last",
            "notFirst",
            "notLast",
            "odd",
            "even"
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "not": {
              "const": 0
            }
          },
          "description": "1-based page numbers; negative numbers count from the end (-1 is the last page)"
        }
      ]
    }
  }
}
