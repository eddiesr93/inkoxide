{
  "name": "inkoxide-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:node": "scripts/build-node.sh",
    "typecheck": "tsc -p .",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "test": "vitest run",
    "examples": "pnpm --filter @inkoxide/examples render",
    "release:stage": "node scripts/release/stage.mjs",
    "release:publish": "scripts/release/publish.sh",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "json-schema-to-typescript": "16.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
